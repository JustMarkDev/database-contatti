{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "database-contatti",
  "version": "1.0.0",
  "identifier": "com.mark.database-contatti",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "database-contatti",
        "width": 800,
        "height": 600,
        "theme": "Dark",
        "backgroundColor": "#171d20",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/gazetteer/*", "resources/pi-classifier-extension.ts"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzMUNEQzBBMDI3NTM3OTIKUldTU04zVUNDdHdjODlwbm5GbEc2WjlMR2t4VGV4R3hYYUEyOXNsNUxuVTE4bkEwckdlMk9TN2gK",
      "endpoints": [
        "https://github.com/JustMarkDev/database-contatti/releases/latest/download/latest.json"
      ]
    }
  }
}
